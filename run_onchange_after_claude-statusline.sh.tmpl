{{- /*
  Wire the public Claude Code status line (~/.claude/statusline.sh) into
  ~/.claude/settings.json, on machines WITHOUT the private overlay only.

  Layering:
    public default  -> this script sets `statusLine` when nothing else owns it
    private overlay -> privateRepo set: this template renders EMPTY, so chezmoi
                       never runs it; the overlay's settings.json symlink (and its
                       own status line) are left alone
    local override  -> a `statusLine` pointing anywhere else is respected, untouched

  Only the `statusLine` key is written; every other setting is preserved. Claude
  Code itself rewrites settings.json (/config), which is why the file is merged
  here rather than owned by chezmoi.
  run_onchange: re-runs only when this rendered script changes.
*/ -}}
{{- if not (index . "privateRepo") -}}
#!/usr/bin/env bash
set -euo pipefail

F="$HOME/.claude/settings.json"
CMD='~/.claude/statusline.sh'
REFRESH=2   # seconds; re-aligns after a resize and ticks the reset countdowns

warn() { printf '\033[1;33m!!\033[0m claude-statusline: %s\n' "$1" >&2; }

command -v jq >/dev/null 2>&1 || { warn "jq not installed; skipping (the status line needs it too)"; exit 0; }
mkdir -p "$HOME/.claude"

if [ -L "$F" ]; then
  warn "$F is a symlink (managed elsewhere); leaving it alone"; exit 0
fi

if [ -s "$F" ]; then
  jq -e 'type == "object"' "$F" >/dev/null 2>&1 || { warn "$F is not a JSON object; leaving it alone"; exit 0; }
  current=$(jq -r '.statusLine.command // empty' "$F")
  if [ -n "$current" ] && [ "$current" != "$CMD" ] && [ "$current" != "$HOME/.claude/statusline.sh" ]; then
    warn "statusLine already points at '$current'; keeping your override"; exit 0
  fi
  src="$F"
else
  src=/dev/null   # absent or empty: start from {}
fi

tmp=$(mktemp "$F.XXXXXX")
trap 'rm -f "$tmp"' EXIT
if [ "$src" = /dev/null ]; then echo '{}'; else cat "$src"; fi |
  jq --arg cmd "$CMD" --argjson r "$REFRESH" \
     '.statusLine = {type: "command", command: $cmd, padding: 0, refreshInterval: $r}' > "$tmp"
mv -f "$tmp" "$F"
trap - EXIT
printf '\033[1;34m::\033[0m claude-statusline: statusLine -> %s\n' "$CMD"
{{- end }}
